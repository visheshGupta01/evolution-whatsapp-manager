NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Evolution API v2
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me
EVOLUTION_TIMEOUT_MS=15000

# Optional webhook HMAC secret. Configure the same secret in Evolution API.
EVOLUTION_WEBHOOK_SECRET=

# Backend safety limits
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
