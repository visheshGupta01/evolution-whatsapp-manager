NODE_ENV=development
PORT=3000
CLIENT_ORIGIN=http://localhost:5173

# Evolution API v2
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=change-me
EVOLUTION_TIMEOUT_MS=15000

# Backend safety limits
BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Campaign safety
CAMPAIGN_MIN_DELAY_MS=1500
CAMPAIGN_MAX_ACTIVE=1
CAMPAIGN_DAILY_RECIPIENT_LIMIT=1000
CAMPAIGN_CREATE_WINDOW_MINUTES=10
CAMPAIGN_CREATE_LIMIT=10
CAMPAIGN_AUTO_PAUSE_MIN_RESULTS=20
CAMPAIGN_AUTO_PAUSE_FAILURE_RATE=0.35

# PostgreSQL campaign persistence
DATABASE_URL=postgresql://postgres:password@localhost:5432/evolution_manager
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Public URL of this manager's Evolution delivery webhook
EVOLUTION_WEBHOOK_URL=https://your-domain.com/api/webhooks/evolution
